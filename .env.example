# Required
ANTHROPIC_API_KEY=
EXA_API_KEY=
MAILTRAP_SMTP_USER=
MAILTRAP_SMTP_PASS=

# Optional
HUNTER_API_KEY=
LANGSMITH_API_KEY=
LANGSMITH_TRACING=true
# LANGSMITH_PROJECT=outreach-bot  # do not set together with LANGSMITH_AGENT_ID: the SDK then traces nothing
LANGSMITH_ENDPOINT=https://api.smith.langchain.com
LANGSMITH_AGENT_ID=outreach
LANGSMITH_AGENT_ENVIRONMENT=local
# Directory holding config/ and .env; defaults to the repo root.
OUTREACH_HOME=
